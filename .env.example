DATABASE_URL="postgresql://postgres:postgres@localhost:5432/champaign_church_directory"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3005"
NEXT_PUBLIC_CHURCH_DIRECTORY_URL="http://localhost:3004"
NEXT_PUBLIC_MUSICIAN_DIRECTORY_URL="http://localhost:3005"
# In production, set these to your live domains or Vercel URLs.
MAPBOX_EMBED_STYLE="streets-v12"
MAPBOX_TOKEN=""
CRON_SECRET="replace-with-cron-secret"
ADMIN_EMAIL="admin@example.com"
SCAN_USER_AGENT="ChampaignCountyChurchDirectoryBot/1.0 (+https://example.com)"

# --- Gig request notifications -------------------------------------------
# Optional. Without these, a submitted request is still validated and written
# to the server log, and the confirmation screen asks the organization to send
# a copy by email themselves. Set all three and requests are emailed to you.
#
# RESEND_API_KEY      from resend.com (free tier covers 3,000 emails/month)
# GIG_NOTIFICATION_FROM  must be on a domain verified with Resend
# GIG_NOTIFICATION_EMAIL where requests land; falls back to ADMIN_EMAIL
RESEND_API_KEY=""
GIG_NOTIFICATION_FROM="requests@yourdomain.com"
GIG_NOTIFICATION_EMAIL="hello@centralilmusicministry.com"
