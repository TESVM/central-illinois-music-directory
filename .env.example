DATABASE_URL="postgresql://postgres:postgres@localhost:5432/champaign_church_directory"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3005"
NEXT_PUBLIC_CHURCH_DIRECTORY_URL="http://localhost:3004"
NEXT_PUBLIC_MUSICIAN_DIRECTORY_URL="http://localhost:3005"
# In production, set these to your live domains or Vercel URLs.
MAPBOX_EMBED_STYLE="streets-v12"
MAPBOX_TOKEN=""
CRON_SECRET="replace-with-cron-secret"
ADMIN_EMAIL="admin@example.com"
SCAN_USER_AGENT="ChampaignCountyChurchDirectoryBot/1.0 (+https://example.com)"

# --- Notifications --------------------------------------------------------
# Covers gig requests, musician profile submissions, and contact messages.
# Without these, submissions are still validated and written to the server log,
# and each confirmation screen asks the sender to email a copy themselves.
#
# Verify setup at any time with:  npm run check:email
#
# RESEND_API_KEY   from resend.com — free tier covers 3,000 emails/month.
# GIG_NOTIFICATION_EMAIL   where submissions land. Falls back to ADMIN_EMAIL.
# GIG_NOTIFICATION_FROM    OPTIONAL. Leave unset to use Resend's sandbox
#   sender, which needs no domain verification but only delivers to the email
#   that owns your Resend account. Once you own a domain and verify it with
#   Resend, set this to an address on it to send anywhere.
RESEND_API_KEY=""
GIG_NOTIFICATION_EMAIL="you@yourdomain.com"
# GIG_NOTIFICATION_FROM="requests@yourdomain.com"
